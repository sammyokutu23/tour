# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.
# Everything is optional for local development: without DATABASE_URL an embedded
# Postgres (PGlite) is used, emails go to the dev mailbox, and payments use the
# clearly-labelled sandbox provider.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Beyond the Destination"
NEXT_PUBLIC_BRAND_SHORT_NAME=Beyond
NEXT_PUBLIC_BRAND_TAGLINE="Your journey. Your guide. Your Kenya."
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Database — Supabase/Postgres connection string (required in production)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Set to "false" for local Postgres without TLS
DATABASE_SSL=true
# Local embedded database directory (development only)
PGLITE_DATA_DIR=.data/pglite

# Secrets (generate with: openssl rand -hex 32)
FILE_SIGNING_SECRET=
CRON_SECRET=

# Private document storage — Supabase Storage (private bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=provider-documents

# Email — "dev" (local mailbox) or "resend"
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM="Beyond the Destination <bookings@example.com>"

# Payments: sandbox (development/test only)
SANDBOX_WEBHOOK_SECRET=
# Only for staging/test environments running NODE_ENV=production
PAYMENTS_SANDBOX_ENABLED=false

# Payments: Safaricom Daraja (M-Pesa Express / STK Push) — see docs/payments.md
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Long random value; appended to the callback URL and checked on every callback
MPESA_CALLBACK_TOKEN=

# Maps — optional Mapbox token for map tiles (otherwise OpenStreetMap tiles; dev only)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Seeding (development only)
SEED_PASSWORD=
